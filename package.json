{
  "name": "stock-scanner",
  "version": "1.0.0",
  "description": "Free, shareable fundamental stock report scanner (BDInvesting-style) for NASDAQ + TSX tickers. Data via Yahoo Finance. Educational / informational only.",
  "type": "module",
  "main": "cli.js",
  "bin": {
    "stock-scanner": "cli.js"
  },
  "scripts": {
    "report": "node cli.js",
    "serve": "node server.js",
    "lt:scan": "node longterm/cli.js",
    "lt:monitor": "node longterm/monitor/monitorCli.js",
    "lt:watchlist": "node longterm/monitor/watchlistCli.js",
    "lt:test": "node --test longterm/tests/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "yahoo-finance2": "^3.15.2"
  },
  "engines": {
    "node": ">=18"
  }
}
